# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-me-in-production

# Web Push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@nippontoyota.com
